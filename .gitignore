# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# throwaway dist dirs from one-off prod builds (NEXT_DIST_DIR) used to measure the
# public JS bundle against the pre-Payload baseline; never committed.
/.next-base/
/.next-payload/
/.next-seocheck/
/.next-local-test/
/.next-sitedash/
/.next-pre/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch output from scripts/wp-sweep.mjs
/.tmp/

# scripts/audit-contrast.mjs output: ~140 PNGs per run (~120 MB), referenced by file
# name from docs/contrast-report.md instead of being committed
/docs/screenshots/

.vercel
.env*
!.env.example

# SiteDash: the scanner's manifest, the baked snapshot and the codemod's backups are
# generated per machine and per publish. The snapshot is what the public site renders
# when the database is down, so it is rebuilt by `sitedash db:export` / `publish` —
# committing a stale copy would let a checkout serve content someone unpublished.
# Ignoring the folder also keeps Tailwind from scanning the manifest's class-like keys.
.sitedash/
/.next-sitedash-pub/
