# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch output from scripts/wp-sweep.mjs
/.tmp/

# fresh WordPress dumps from scripts/sync-wp.mjs (BK-7.1). Each sweep writes a new
# timestamped folder next to the frozen data/wp/ backup; kept on disk as drift
# evidence, never committed — 3.4 MB per re-sync, re-generable in a minute.
/data/wp-*/

# scripts/audit-contrast.mjs output: ~140 PNGs per run (~120 MB), referenced by file
# name from docs/contrast-report.md instead of being committed
/docs/screenshots/

# browser screenshots taken while verifying a row in the built app: the evidence stays
# on disk for the run, and the PROGRESS row says what it showed
/.shots/

# BK-19: WordPress copies, media and `mysqldump` output, and now `npm run backup` (a
# database dump plus the uploads archive). The owner's rule is that a backup must exist
# before anything is removed and must never be committed — they hold leads and password
# hashes, so ignoring them is not the same as making them safe to upload. One folder,
# ignored whole, rather than a pattern that could miss a dump.
/backups/

# Where uploads land during local work: `src/lib/media/store.ts` puts every uploaded
# picture under `public/uploads/<yyyyMM>/`, and the upload tests write real files there
# on each run. Bytes a person owns, not source: on the server MEDIA_ROOT points at a
# folder outside the app (see .env.example), and this one is covered by the nightly
# backup and is deliberately absent from the deploy artifact.
/public/uploads/

.vercel
.env*
!.env.example
