# Shamah — site + console environment
#
# Copy this file to `.env.local` (git-ignored) and fill in the blanks. Never commit
# real values. `npm run doctor` checks every variable below and prints NAMES only.
# The console's own credentials live in the database, not here.

# ---------------------------------------------------------------------------
# Database — MySQL/MariaDB, the dialect cPanel hosts
# ---------------------------------------------------------------------------
# Local dev is a disposable MariaDB on 127.0.0.1:3307 (docs/LOCAL-MARIADB.md);
# `npm run db:local:provision` writes these five plus the secrets for you.
# On cPanel you create the database + user in the panel and set the same names.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_NAME=shamah_cms
DATABASE_USER=shamah_app
DATABASE_PASSWORD=
# Connection pool size per Node process. cPanel shared hosts want this small.
DATABASE_POOL_SIZE=8

# TLS to the database is OFF unless you ask for it here. Production is MariaDB on the
# same machine over loopback; a remote database sets `require` (encrypted, certificate
# not checked) or `verify` (certificate checked against the system roots, or against
# the PEM file named by DATABASE_TLS_CA_FILE). There is no other switch for it.
DATABASE_TLS=
DATABASE_TLS_CA_FILE=

# One URL instead of the five above; the discrete variables win if both are set.
# Format: mysql://user:password@host:port/database
DATABASE_URL=

# Off by default. `1` prints one `[dbq]` line per SQL statement (the SQL text only, never
# a bound value) to the server log; the per-route counts in PROGRESS were taken with it.
DATABASE_LOG_QUERIES=

# Root password of the LOCAL disposable server only, used by `npm run db:local:stop`.
# There is no such thing in production — never set this on a host.
LOCAL_DB_ROOT_PASSWORD=
# Where the portable MariaDB lives, if not D:\mariadb.
LOCAL_MARIADB_BASEDIR=
LOCAL_MARIADB_MY_INI=

# ---------------------------------------------------------------------------
# Console authentication
# ---------------------------------------------------------------------------
# Signs session cookies. 32 random bytes, hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# The public site
# ---------------------------------------------------------------------------
# The single source for canonical, og:url, og:image, sitemap, robots and JSON-LD.
# A production build or `next start` FAILS when this is unset. Point it at the
# deployed site — never at the WordPress import origin. While we test, that is the
# subdomain; the live WordPress site keeps its own address until the switch.
NEXT_PUBLIC_SITE_URL=https://test.shamahclinics.com
# Shared secret for POST /api/revalidate, sent as the `x-revalidate-secret` header.
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Media — where an uploaded picture is written
# ---------------------------------------------------------------------------
# Disk only. There is no hosted/blob driver and no token to obtain: the bytes go to a
# folder on this server. Uploads are re-encoded by sharp (WebP, EXIF stripped, random
# name) before they land here, so the folder never holds what a camera wrote.
#
# Default is `public/uploads` inside the app, which is what the site serves during
# local work. On the server ALWAYS set an absolute path outside the app folder and
# outside the build output (e.g. /home/<cpanel-user>/shamah-media), because a
# redeploy replaces the app folder and everything under it. The app writes into
# `<MEDIA_ROOT>/uploads/`, and the address stored in the database is
# `/uploads/<yyyymm>/<hash>.webp` either way, so moving the folder never rewrites a
# row. On the server that folder is also what `npm run backup` archives, and the web
# server must not be allowed to execute anything in it.
MEDIA_ROOT=

# ---------------------------------------------------------------------------
# WordPress — the frozen snapshot's origin
# ---------------------------------------------------------------------------
# BK-7.3 removed every runtime read of WordPress, so this host is only used to
# recognise and rewrite URLs already inside data/wp/*.json (src/lib/wp/mirror.ts
# maps them onto public/wp/, the lead route's optional cf7 mode posts to it).
# The default is in src/lib/wp/config.ts; set it only to override.
WP_BASE_URL=https://www.shamahclinics.com
# whatsapp (default) returns a prefilled wa.me link and stores nothing.
# cf7 posts the lead to the live Contact Form 7, which emails the clinic.
LEAD_MODE=whatsapp
CF7_FORM_ID=568

# ---------------------------------------------------------------------------
# Mobile app API — /api/mobile/*  (docs/MOBILE-API.md)
# ---------------------------------------------------------------------------
# Shared secret compiled into the Flutter app (--dart-define=SHAMAH_API_PASSWORD=...).
# Unset = the mobile API answers every call with 401. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MOBILE_API_PASSWORD=
# Loyalty: points earned per EGP of a visited booking (0.1 = 1 point per 10 EGP),
# the EGP value of one point, and the points a new account starts with.
MOBILE_POINTS_PER_EGP=0.1
MOBILE_POINT_VALUE_EGP=0.1
MOBILE_SIGNUP_BONUS_POINTS=0
