# WordPress stays a READ-ONLY CMS. Only GET requests hit WordPress
# (plus the CF7 feedback POST, which only fires when LEAD_MODE=cf7).

# Root of the live WordPress install. Arabic content is read from <WP_BASE_URL>/ar/wp-json.
WP_BASE_URL=https://www.shamahclinics.com

# How booking/contact leads are delivered:
#   whatsapp (default, safe) -> returns a prefilled wa.me link; nothing is emailed.
#   cf7                      -> posts the lead to the live Contact Form 7 (EMAILS THE CLINIC).
LEAD_MODE=whatsapp

# Contact Form 7 form id used only when LEAD_MODE=cf7. Confirm the real id + field
# names from the booking page HTML before enabling cf7 mode.
CF7_FORM_ID=568

# Shared secret that protects POST /api/revalidate. Send it as
# header `x-revalidate-secret` (or ?secret=). Required before the webhook works.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Live WordPress budget at runtime (the build never calls WordPress).
# Requests are aborted after this many ms and the committed snapshot in data/wp is served.
WP_FETCH_TIMEOUT_MS=8000
# Global ceiling on concurrent live WordPress requests.
WP_MAX_INFLIGHT=3
# Cache TTL (seconds) for category + media reads. Posts and products always refresh
# on the 300 s ISR window; taxonomies change far less often, and each WordPress round
# trip costs seconds, so caching them longer keeps page renders fast.
WP_TAXONOMY_REVALIDATE=3600

# Public origin of THIS site; the single source for canonical, hreflang, og:url,
# og:image, sitemap, robots and JSON-LD. A production build/serving FAILS if this
# is unset. Set it to the deployment URL (https://shamah-clinic.vercel.app), then
# to the real production domain once one is attached. Never the WordPress import
# origin — that domain is WP_BASE_URL, not this.
NEXT_PUBLIC_SITE_URL=https://shamah-clinic.vercel.app

# ---------------------------------------------------------------------------
# Payload CMS (admin at /admin). WordPress becomes a one-time import source.
# ---------------------------------------------------------------------------

# Neon Postgres. DATABASE_URI is the POOLED connection string used at runtime;
# DATABASE_URI_DIRECT is the non-pooled one used for migrations (push/generate).
# Both require sslmode=require on Neon.
DATABASE_URI=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URI_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# 32 random bytes, hex-encoded (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-64-char-hex

# Vercel Blob read/write token for the media store (shamah-media).
# Added automatically when the store is connected to the project.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
