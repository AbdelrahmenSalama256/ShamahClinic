{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@payload-config": [
        "./src/payload.config.mts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-seocheck/types/**/*.ts",
    ".next-seocheck/dev/types/**/*.ts",
    ".next-base/types/**/*.ts",
    ".next-base/dev/types/**/*.ts",
    ".next-payload/types/**/*.ts",
    ".next-payload/dev/types/**/*.ts",
    ".next-local-test/types/**/*.ts",
    ".next-local-test/dev/types/**/*.ts",
    ".next-sitedash/types/**/*.ts",
    ".next-sitedash/dev/types/**/*.ts",
    ".next-sitedash-pub/types/**/*.ts",
    ".next-sitedash-pub/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
